# Copy to .env and fill locally. Never commit .env or paste values into chat.
META_MODEL_API_KEY=
META_STT_MODEL=muse-voice-transcribe-1.0
META_INTENT_MODEL=muse-spark-1.3
GEMINI_API_KEY=
# Intent LLM: gemini (primary, Muse Spark fallback on error) or muse
INTENT_PROVIDER=gemini
# Must be a model ID your account can actually list (see docs/07_APIS_AND_ENV.md)
GEMINI_MODEL=

CAMERA_INDEX=0
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_FPS=15

# Developer-only original/source recording access; keep false for judges.
ENABLE_DIAGNOSTIC_ORIGINAL=false
ALLOW_REMOTE_FACE_UPLOAD=false
RECORDINGS_DIR=recordings
MODELS_DIR=models
