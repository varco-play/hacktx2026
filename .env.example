# Copy to .env and fill locally. Never commit .env or paste values into chat.
META_MODEL_API_KEY=
META_STT_MODEL=muse-voice-transcribe-1.0
META_INTENT_MODEL=muse-spark-1.3
GEMINI_API_KEY=
# Intent LLM: gemini (primary, Muse Spark fallback on error) or muse
INTENT_PROVIDER=gemini
# Must be a model ID your account can actually list (see docs/07_APIS_AND_ENV.md)
GEMINI_MODEL=

CAMERA_INDEX=0
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_FPS=15

# Developer-only original/source recording access; keep false for judges.
ENABLE_DIAGNOSTIC_ORIGINAL=false
ALLOW_REMOTE_FACE_UPLOAD=false
RECORDINGS_DIR=recordings
# Cloudflare R2 (private bucket). When all three are set, videos are uploaded and NOT kept locally.
S3_API=https://<account_id>.r2.cloudflarestorage.com/<bucket>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Raw/original upload to R2 restricted/ prefix (never linked to the browser). Default off.
RAW_UPLOAD_R2=false
MODELS_DIR=models

# Default quality profile, camera, privacy policy, companion ingest
QUALITY_PROFILE=BALANCED
CAMERA=
PRIVACY_DEFAULT=visible
INGEST_TOKEN=
